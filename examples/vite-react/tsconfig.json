{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["dom", "dom.iterable", "es2024"],
    "types": ["vite/client"],
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "isolatedModules": true,
    "jsx": "react-jsx"
  },
  "include": ["src", "svgworm", "vite.config.ts"]
}
