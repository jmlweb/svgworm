{
  "name": "svgworm-example-vite-react",
  "version": "0.0.0",
  "private": true,
  "description": "svgworm in a client-rendered Vite + React app: typed icons from a content-hashed sprite in public/icons/, with a base-aware build check.",
  "type": "module",
  "engines": {
    "node": "^22.20.0 || >=24.11.0"
  },
  "scripts": {
    "predev": "svgworm",
    "dev": "vite",
    "prebuild": "svgworm",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "svgworm check",
    "check:dist": "node scripts/check-dist.mjs",
    "check:base": "node scripts/check-base.mjs"
  },
  "dependencies": {
    "@svgworm/react": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "svgworm": "workspace:*",
    "typescript": "6.0.3",
    "vite": "8.3.3"
  }
}
