// Cloudflare serves dist/ and applies public/_headers (ADR-0016). The Worker runs first only on
// the pages, to answer Accept: text/markdown with their .md files (ADR-0032).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "svgworm",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/docs", "/docs/*"],
  },
  "workers_dev": true,
  // Every same-repo PR uploads a version with --preview-alias pr-<number>.
  "preview_urls": true,
}
