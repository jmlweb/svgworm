# Sprite file names are content-hashed by svgworm, so a year-long immutable cache is safe.
/icons/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Astro hashes everything under _astro/ (logo SVGs), so the same rule is safe there.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
