---
import { manifest } from '../../svgworm/icons.js';
import { traceIcon } from '../lib/worked-example';
import Icon from './Icon.astro';

type Props = {
  // The same generated markup the #why tile shows, so the two sections cannot disagree.
  readonly terminalComment: string;
};

const { terminalComment } = Astro.props;

// One real icon of this site, read from the committed files at build time (TSK-104).
const trace = traceIcon('terminal');
const spriteUrl = manifest.sprites[manifest.icons.terminal.sprite]?.sprite?.url;
const sourceLines = trace.source.split('\n').length;
---

<section aria-labelledby="demo" class="section section-raised">
  <div class="wrap">
    <p class="kicker">One icon, end to end</p>
    <h2 id="demo">Follow terminal.svg from file to render.</h2>
    <p class="section-lede">
      This is the <code>terminal</code> icon of this site, <strong
        >read from its committed files when the page was built</strong
      >. Nothing below is copied by hand.
    </p>
    <ol class="steps trace-steps">
      <li>
        <span class="step-label step-label-you">you write</span>
        <h3>Your SVG file</h3>
        <p>
          Drop it in <code>icons/</code> as exported, comments and all.
        </p>
        <details class="trace-details">
          <summary>icons/terminal.svg, {sourceLines} lines</summary>
          <pre aria-label="Source of icons/terminal.svg" class="code" role="region" tabindex="0"><code>{trace.source}</code></pre>
        </details>
      </li>
      <li>
        <span class="step-label step-label-generated">svgworm generates</span>
        <h3>A symbol in the sprite</h3>
        <p>
          Optimized, with an id from its name, in <code>public{spriteUrl}</code>.
        </p>
        <pre aria-label="The terminal symbol in the sprite" class="code" role="region" tabindex="0"><code>{trace.symbol}</code></pre>
      </li>
      <li>
        <span class="step-label step-label-generated">svgworm generates</span>
        <h3>Its manifest entry</h3>
        <p>
          The id, size, color and delivery the component reads.
        </p>
        <pre aria-label="The terminal entry in svgworm/manifest.json" class="code" role="region" tabindex="0"><code>{trace.manifestEntry}</code></pre>
      </li>
      <li>
        <span class="step-label step-label-you">you write</span>
        <h3>One line in your page</h3>
        <p class="trace-render">
          It renders as a <code>&lt;use href&gt;</code>:
          <Icon height={28} name="terminal" width={28} />
        </p>
        <pre aria-label="Icon usage and generated markup" class="code" role="region" tabindex="0"><code><span class="c-tag">&lt;Icon</span> <span class="c-attr">name</span>=<span class="c-str">"terminal"</span> <span class="c-tag">/&gt;</span>
<span class="c-comment">{terminalComment}</span></code></pre>
      </li>
    </ol>
  </div>
</section>
