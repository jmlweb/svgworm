---
import { manifest } from '../../svgworm/icons.js';
import { traceIcon } from '../lib/worked-example';

// The hardest icon of this site, read from the committed files at build time (TSK-104): a stroke
// icon cannot fail, so it would prove nothing.
const iconName = 'proof/agate';
// The copy below explains the stack file and <img>, so a changed delivery must stop the build.
if (manifest.icons[iconName].delivery !== 'img') {
  throw new Error(`worked example: ${iconName} no longer renders as <img>`);
}
const trace = traceIcon(iconName);
const sourceLines = trace.source.split('\n').length;
// The parent renders the real <Icon>, so step 4 prints the markup this page ships, not a template
// of it.
const rendered = (await Astro.slots.render('default')).trim();
---

<section aria-labelledby="demo" class="section section-raised">
  <div class="wrap">
    <p class="kicker">One icon, end to end</p>
    <h2 id="demo">Follow agate.svg from file to render.</h2>
    <p class="section-lede">
      The hardest icon on this site: gradients and a clip path, which WebKit
      drops from an external <code>&lt;use&gt;</code>. Steps 1 to 3 are <strong
        >read from its committed files when the page was built</strong
      >, and step 4 is the markup this page rendered. Nothing is pasted in.
    </p>
    <ol class="steps trace-steps">
      <li>
        <span class="step-label step-label-you">you write</span>
        <h3>Your SVG file</h3>
        <p>
          Drop it in <code>icons/</code> as exported, comments and all.
        </p>
        <details class="trace-details">
          <summary>icons/{iconName}.svg, {sourceLines} lines</summary>
          <pre aria-label={`Source of icons/${iconName}.svg`} class="code" role="region" tabindex="0"><code>{trace.source}</code></pre>
        </details>
      </li>
      <li>
        <span class="step-label step-label-generated">svgworm generates</span>
        <h3>An entry in the stack file</h3>
        <p>
          Its <code>url(#…)</code> references keep it out of the sprite, so it
          goes to <code>public{trace.fileUrl}</code>, optimized.
        </p>
        <pre aria-label="The agate entry in the stack file" class="code" role="region" tabindex="0"><code>{trace.generated}</code></pre>
      </li>
      <li>
        <span class="step-label step-label-generated">svgworm generates</span>
        <h3>Its manifest entry</h3>
        <p>
          The id, size, color and delivery the component reads.
        </p>
        <pre aria-label="The agate entry in svgworm/manifest.json" class="code" role="region" tabindex="0"><code>{trace.manifestEntry}</code></pre>
      </li>
      <li>
        <span class="step-label step-label-you">you write</span>
        <h3>One line in your page</h3>
        <p class="trace-render">
          It renders as an <code>&lt;img&gt;</code>:
          <Fragment set:html={rendered} />
        </p>
        <pre aria-label="Icon usage and generated markup" class="code" role="region" tabindex="0"><code><span class="c-tag">&lt;Icon</span> <span class="c-attr">name</span>=<span class="c-str">"{iconName}"</span> <span class="c-tag">/&gt;</span>
<span class="c-comment">// {rendered}</span></code></pre>
      </li>
    </ol>
  </div>
</section>
