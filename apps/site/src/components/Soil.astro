---
import type { IconName } from '../../svgworm/icons.js';
import Icon from './Icon.astro';

type Pebble = {
  readonly icon: IconName;
  readonly x: number;
  readonly y: number;
  readonly size: number;
  readonly tilt: number;
};

// Icons buried in the bottom layer, in viewBox units, so they scale and crop with the art.
// The layer's top edge is at y 121-145; the centres sit below it with room for the icon.
const pebbles: readonly Pebble[] = [
  { icon: 'folder-open', x: 150, y: 176, size: 28, tilt: -12 },
  { icon: 'file-code', x: 440, y: 186, size: 24, tilt: 9 },
  { icon: 'zap', x: 660, y: 180, size: 22, tilt: 18 },
  { icon: 'server', x: 880, y: 182, size: 26, tilt: -6 },
  { icon: 'package', x: 1110, y: 170, size: 28, tilt: 14 },
  { icon: 'layers', x: 1330, y: 184, size: 24, tilt: -10 },
];

// The worm crawls right to left through a tunnel shaped like a sine wave. Its body is the
// same wave in the worm's own frame: as the group slides one wavelength, the body shape runs
// one full cycle, so every point of the body stays inside the tunnel. The slide covers a whole
// number of wavelengths and the body loop the matching period, so both loops repeat without a
// seam. The shape is sampled into points and smoothed with Catmull-Rom; every frame has the same
// commands, so SMIL morphs between them.
const head = 420;
const tail = 730;
const midline = 104;
const wavelength = 220;
const amplitude = 16;
const wavePeriod = 2.4;
const frames = 16;
// The worm starts just past the right edge and ends just past the left one: 8 wavelengths.
const enter = 1025;
const leave = enter - 8 * wavelength;
const crossing = 8 * wavePeriod;
// Start 4 wavelengths in, with the worm centred, so the band is never empty on load and a
// paused worm (reduced motion) is in view. A whole number of periods keeps the body in step.
const alreadyCrawled = 4 * wavePeriod;

const round = (n: number): number => Math.round(n * 10) / 10;

const smooth = (points: readonly (readonly [number, number])[]): string => {
  const at = (i: number) => points[Math.max(0, Math.min(points.length - 1, i))]!;
  const curves = points.slice(1).map((_, i) => {
    const [a, b, c, d] = [at(i - 1), at(i), at(i + 1), at(i + 2)];
    return `C${round(b[0] + (c[0] - a[0]) / 6)} ${round(b[1] + (c[1] - a[1]) / 6)} ${round(c[0] - (d[0] - b[0]) / 6)} ${round(c[1] - (d[1] - b[1]) / 6)} ${round(c[0])} ${round(c[1])}`;
  });
  return `M${round(at(0)[0])} ${round(at(0)[1])} ${curves.join(' ')}`;
};

const waveY = (x: number, phase: number): number =>
  midline + amplitude * Math.sin((2 * Math.PI * x) / wavelength - 2 * Math.PI * phase);

const sampled = (from: number, to: number, phase: number, offset: number): string => {
  const count = Math.round(((to - from) / wavelength) * 8);
  return smooth(
    Array.from({ length: count + 1 }, (_, i) => {
      const x = from + ((to - from) * i) / count;
      return [x, waveY(x - offset, phase)] as const;
    }),
  );
};

const bodyAt = (phase: number): string => sampled(head, tail, phase, head);
const bodyFrames = Array.from({ length: frames + 1 }, (_, i) => bodyAt(i / frames)).join(';');
const tunnel = sampled(-wavelength / 2, 1440 + wavelength / 2, 0, enter + head);
---

<div class="soil">
  <svg
    aria-hidden="true"
    class="soil-art"
    focusable="false"
    preserveAspectRatio="xMidYMin slice"
    viewBox="0 0 1440 236"
  >
    <defs>
      <filter id="soil-edge" x="-5%" y="-20%" width="110%" height="140%">
        <feDropShadow dx="0" dy="-3" stdDeviation="4" flood-color="#000" flood-opacity="0.35"
        ></feDropShadow>
      </filter>
      <filter id="worm-blur" x="-10%" y="-60%" width="120%" height="220%">
        <feGaussianBlur stdDeviation="4"></feGaussianBlur>
      </filter>
      <clipPath id="soil-layer-2">
        <path d="M0 73 C 300 53, 540 95, 820 70 S 1250 55, 1440 77 V236 H0Z"></path>
      </clipPath>
      <path d={bodyAt(0)} id="worm-path" pathLength="100">
        <animate
          attributeName="d"
          dur={`${String(wavePeriod)}s`}
          repeatCount="indefinite"
          values={bodyFrames}></animate>
      </path>
    </defs>
    <path
      class="stratum stratum-1"
      d="M0 26 C 240 5, 480 47, 720 26 S 1200 5, 1440 29 V236 H0Z"
    ></path>
    <path
      class="stratum stratum-2"
      d="M0 73 C 300 53, 540 95, 820 70 S 1250 55, 1440 77 V236 H0Z"
      filter="url(#soil-edge)"
    ></path>
    <!-- The worm lives in the middle layer: clipped to it at the top, and the bottom layer
         is painted over it, so it dips out of sight where the tunnel goes deeper. -->
    <g clip-path="url(#soil-layer-2)">
      <path class="worm-tunnel" d={tunnel}></path>
      <g class="worm">
        <animateTransform
          attributeName="transform"
          begin={`-${String(alreadyCrawled)}s`}
          dur={`${String(crossing)}s`}
          from={`${String(enter)} 0`}
          repeatCount="indefinite"
          to={`${String(leave)} 0`}
          type="translate"></animateTransform>
        <use class="worm-shadow" filter="url(#worm-blur)" href="#worm-path" y="6"></use>
        <use class="worm-rim" href="#worm-path"></use>
        <use class="worm-body" href="#worm-path"></use>
        <use class="worm-rings" href="#worm-path">
          <animate
            attributeName="stroke-dashoffset"
            dur="1.6s"
            repeatCount="indefinite"
            values="0;-4"></animate>
        </use>
        <use class="worm-saddle" href="#worm-path"></use>
        <use class="worm-shine" href="#worm-path" y="-4"></use>
      </g>
    </g>
    <path
      class="stratum stratum-3"
      d="M0 140 C 280 125, 620 160, 900 136 S 1270 118, 1440 142 V236 H0Z"
      filter="url(#soil-edge)"
    ></path>
    {
      pebbles.map((pebble) => (
        <g
          class="pebble"
          transform={`translate(${String(pebble.x - pebble.size / 2)} ${String(pebble.y - pebble.size / 2)}) rotate(${String(pebble.tilt)} ${String(pebble.size / 2)} ${String(pebble.size / 2)})`}
        >
          <Icon height={pebble.size} name={pebble.icon} width={pebble.size} />
        </g>
      ))
    }
    <!-- Bedrock: the same color as the stats band below, so the band rises into the soil. -->
    <path
      class="stratum stratum-bedrock"
      d="M0 216 C 260 205, 600 228, 900 213 S 1280 203, 1440 215 V236 H0Z"
      filter="url(#soil-edge)"
    ></path>
  </svg>
  <button
    aria-label="Pause the worm animation"
    aria-pressed="false"
    class="soil-toggle"
    hidden
    type="button"
  >
    <Icon class="soil-toggle-pause" height={16} name="pause" width={16} />
    <Icon class="soil-toggle-play" height={16} name="play" width={16} />
  </button>
</div>

<script>
  // WCAG 2.2.2: the worm loops forever, so it needs a pause control. SMIL ignores
  // prefers-reduced-motion, so it starts paused there. Off screen it pauses to save battery,
  // without changing the visitor's choice.
  const svg = globalThis.document.querySelector<SVGSVGElement>('.soil-art');
  const toggle = globalThis.document.querySelector<HTMLButtonElement>('.soil-toggle');
  if (svg && toggle) {
    let isPausedByVisitor = globalThis.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let isOnScreen = true;
    const sync = () => {
      if (isPausedByVisitor || !isOnScreen) {
        svg.pauseAnimations();
      } else {
        svg.unpauseAnimations();
      }
      toggle.setAttribute('aria-pressed', String(isPausedByVisitor));
    };
    toggle.addEventListener('click', () => {
      isPausedByVisitor = !isPausedByVisitor;
      sync();
    });
    new globalThis.IntersectionObserver(([entry]) => {
      isOnScreen = entry?.isIntersecting ?? true;
      sync();
    }).observe(svg);
    toggle.hidden = false;
    sync();
  }
</script>
