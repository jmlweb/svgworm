---
import type { IconName } from '../../svgworm/icons.js';
import Icon from './Icon.astro';

type Pebble = {
  readonly icon: IconName;
  readonly x: number;
  readonly y: number;
  readonly size: number;
  readonly tilt: number;
};

// Icons buried in the soil band, in percent of the band. They come from the sprite too.
const pebbles: readonly Pebble[] = [
  { icon: 'folder-open', x: 9, y: 70, size: 26, tilt: -12 },
  { icon: 'file-code', x: 24, y: 84, size: 22, tilt: 9 },
  { icon: 'server', x: 64, y: 80, size: 24, tilt: -6 },
  { icon: 'package', x: 79, y: 66, size: 26, tilt: 14 },
  { icon: 'layers', x: 92, y: 86, size: 22, tilt: -10 },
  { icon: 'zap', x: 46, y: 90, size: 20, tilt: 18 },
];
---

<div aria-hidden="true" class="soil">
  <svg
    class="soil-art"
    focusable="false"
    preserveAspectRatio="xMidYMin slice"
    viewBox="0 0 1440 210"
  >
    <path
      class="stratum stratum-1"
      d="M0 26 C 240 5, 480 47, 720 26 S 1200 5, 1440 29 V210 H0Z"
    ></path>
    <path
      class="stratum stratum-2"
      d="M0 73 C 300 53, 540 95, 820 70 S 1250 55, 1440 77 V210 H0Z"
    ></path>
    <path
      class="stratum stratum-3"
      d="M0 140 C 280 125, 620 160, 900 136 S 1270 118, 1440 142 V210 H0Z"
    ></path>
    <g class="worm">
      <path
        class="worm-body"
        d="M420 104 C 470 76, 520 132, 580 104 S 680 76, 730 100"
        pathLength="100"
      ></path>
      <path
        class="worm-rings"
        d="M420 104 C 470 76, 520 132, 580 104 S 680 76, 730 100"
        pathLength="100"
      ></path>
      <path
        class="worm-saddle"
        d="M420 104 C 470 76, 520 132, 580 104 S 680 76, 730 100"
        pathLength="100"
      ></path>
    </g>
  </svg>
  {
    pebbles.map((pebble) => (
      <span
        class="pebble"
        style={`left:${String(pebble.x)}%;top:${String(pebble.y)}%;transform:translate(-50%, -50%) rotate(${String(pebble.tilt)}deg)`}
      >
        <Icon height={pebble.size} name={pebble.icon} width={pebble.size} />
      </span>
    ))
  }
</div>
