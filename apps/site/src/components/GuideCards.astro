---
import Icon from './Icon.astro';

const REPO = 'https://github.com/jmlweb/svgworm';

const guides = [
  {
    icon: 'server',
    name: 'Next.js',
    line: 'Server Components, zero client JS, Turbopack.',
    links: [
      { href: '/docs/nextjs/', label: 'Next.js guide' },
      {
        href: `${REPO}/tree/main/examples/next-app-router`,
        label: 'examples/next-app-router',
      },
    ],
  },
  {
    icon: 'zap',
    name: 'Vite + React',
    line: 'Hashed sprite that follows your base path.',
    links: [
      { href: '/docs/vite/', label: 'Vite + React guide' },
      {
        href: `${REPO}/tree/main/examples/vite-react`,
        label: 'examples/vite-react',
      },
    ],
  },
  {
    icon: 'file-code',
    name: 'Astro',
    line: 'A dependency-free Icon.astro written by init.',
    links: [{ href: '/docs/astro/', label: 'Astro guide' }],
  },
  {
    icon: 'layers',
    name: 'Vue and Svelte',
    line: 'Icon.vue or Icon.svelte written by init, Nuxt and SvelteKit too.',
    links: [
      { href: '/docs/vue/', label: 'Vue guide' },
      { href: '/docs/svelte/', label: 'Svelte guide' },
    ],
  },
] as const;
---

<section aria-labelledby="guides" class="section">
  <div class="wrap">
    <p class="kicker">Pick your framework</p>
    <h2 id="guides">One guide per stack.</h2>
    <div class="guides">
      {
        guides.map((guide) => (
          <article class="tile">
            <div class="tile-head">
              <span class="badge">
                <Icon name={guide.icon} />
              </span>
              <h3>{guide.name}</h3>
            </div>
            <p>{guide.line}</p>
            <p class="guide-links">
              {guide.links.map((link) => (
                <a href={link.href}>{link.label}</a>
              ))}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
