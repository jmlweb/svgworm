---
type Props = {
  /** Distinct per instance: the radio group name must not be shared across the page. */
  readonly id: string;
};

const { id } = Astro.props;
// Two instances on the landing page: region names must differ.
const where = id === 'hero' ? 'Install command' : 'Install command, second copy';
const commands = {
  next: 'pnpm add -D svgworm && pnpm add @svgworm/react',
  vite: 'pnpm add -D svgworm && pnpm add @svgworm/react',
  astro: 'pnpm add -D svgworm',
} as const;
---

{/*
  A CSS-only framework switch (TSK-049): two radios and :has() show the matching command, so an
  Astro visitor never copies @svgworm/react. The copy button (CopyButtons.astro) is added by
  script and copies the visible command, since the other variants are display: none. Without
  script, one click selects the whole command.
*/}
<div class="install-switch">
  <fieldset class="install-tabs">
    <legend class="visually-hidden">Install command for</legend>
    <label>
      <input checked name={`install-${id}`} type="radio" value="next" />
      Next.js
    </label>
    <label>
      <input name={`install-${id}`} type="radio" value="vite" />
      Vite
    </label>
    <label>
      <input name={`install-${id}`} type="radio" value="astro" />
      Astro
    </label>
  </fieldset>
  <p class="install install-next" data-copy>
    <span aria-hidden="true" class="t-prompt">$</span>
    <code aria-label={`${where} for Next.js`} role="region" tabindex="0">{commands.next}</code>
  </p>
  <p class="install install-vite" data-copy>
    <span aria-hidden="true" class="t-prompt">$</span>
    <code aria-label={`${where} for Vite`} role="region" tabindex="0">{commands.vite}</code>
  </p>
  <p class="install install-astro" data-copy>
    <span aria-hidden="true" class="t-prompt">$</span>
    <code aria-label={`${where} for Astro`} role="region" tabindex="0">{commands.astro}</code>
  </p>
</div>
