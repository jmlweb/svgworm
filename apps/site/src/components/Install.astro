---
type Props = {
  /** Distinct per instance: the radio group name must not be shared across the page. */
  readonly id: string;
};

const { id } = Astro.props;
// Two instances on the landing page: region names must differ.
const where = id === 'hero' ? 'Install command' : 'Install command, second copy';
const commands = {
  next: 'pnpm add -D svgworm && pnpm add @svgworm/react',
  vite: 'pnpm add -D svgworm && pnpm add @svgworm/react',
  astro: 'pnpm add -D svgworm',
  vue: 'pnpm add -D svgworm',
  svelte: 'pnpm add -D svgworm',
} as const;
const labels = {
  next: 'Next.js',
  vite: 'Vite',
  astro: 'Astro',
  vue: 'Vue',
  svelte: 'Svelte',
} as const;
const frameworks = Object.keys(commands) as (keyof typeof commands)[];
---

{/*
  A CSS-only framework switch (TSK-049): a radio per framework and :has() show the matching
  command, so an Astro, Vue or Svelte visitor never copies @svgworm/react. The copy button (CopyButtons.astro) is added by
  script and copies the visible command, since the other variants are display: none. Without
  script, one click selects the whole command.
*/}
<div class="install-switch">
  <fieldset class="install-tabs">
    <legend class="visually-hidden">Install command for</legend>
    {
      frameworks.map((framework, index) => (
        <label>
          <input
            checked={index === 0}
            name={`install-${id}`}
            type="radio"
            value={framework}
          />
          {labels[framework]}
        </label>
      ))
    }
  </fieldset>
  {
    frameworks.map((framework) => (
      <p class={`install install-${framework}`} data-copy>
        <span aria-hidden="true" class="t-prompt">$</span>
        <code aria-label={`${where} for ${labels[framework]}`} role="region" tabindex="0">{commands[framework]}</code>
      </p>
    ))
  }
</div>
