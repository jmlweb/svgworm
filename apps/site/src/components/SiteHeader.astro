---
import logoDark from '../../../../docs/assets/logo-dark.svg?url';
import logoLight from '../../../../docs/assets/logo-light.svg?url';

type Props = {
  /** Current page path with a leading slash, to mark the section in the nav. */
  readonly path: string;
};

const { path } = Astro.props;
const REPO = 'https://github.com/jmlweb/svgworm';
const isComparison = path === '/docs/comparison/';
const isDocs = path.startsWith('/docs/') && !isComparison;
const current = (active: boolean) => (active ? 'page' : undefined);
---

<a class="skip-link" href="#content">Skip to content</a>
<header class="site-header">
  <div class="wrap header-row">
    <a aria-label="svgworm home" class="brand" href="/">
      <picture>
        <source media="(prefers-color-scheme: dark)" srcset={logoDark} />
        <img alt="svgworm" height="40" src={logoLight} width="180" />
      </picture>
    </a>
    <nav aria-label="Project links">
      <a aria-current={current(isDocs)} href="/docs/">Docs</a>
      <a aria-current={current(isComparison)} href="/docs/comparison/">Compare</a>
      <a class="nav-npm" href="https://www.npmjs.com/package/svgworm">npm</a>
      <a class="nav-cta" href={REPO}>GitHub</a>
    </nav>
  </div>
</header>
