---
import { version } from 'svgworm/package.json';

import { manifest } from '../../svgworm/icons.js';
import type { IconName } from '../../svgworm/icons.js';
import { migrationPrompts, setupPrompt } from '../lib/prompts';
import CopyButtons from './CopyButtons.astro';
import GuideCards from './GuideCards.astro';
import Icon from './Icon.astro';
import Install from './Install.astro';
import Soil from './Soil.astro';
import '../styles/landing.css';

type Props = {
  readonly spriteBytes: number;
};

const { spriteBytes } = Astro.props;

const REPO = 'https://github.com/jmlweb/svgworm';

// The page shows the real sprite it was built with, so the samples are the live output.
const spriteUrl = manifest.sprites.icons?.sprite?.url ?? '/icons/icons.svg';
const iconNames = Object.keys(manifest.icons) as IconName[];
const monoIcons = iconNames.filter(
  (name) => manifest.icons[name].color === 'mono',
);
const multicolorIcons = iconNames.filter(
  (name) => manifest.icons[name].color === 'multicolor',
);
const countDelivery = (delivery: 'use' | 'img' | 'mask') =>
  iconNames.filter((name) => manifest.icons[name].delivery === delivery).length;
const terminalId = manifest.icons.terminal.id;

const formatKib = (bytes: number) => `${(bytes / 1024).toFixed(1)} KiB`;
// Icon names are [a-z0-9/-] by contract, so they are safe to inline; a name may wrap after a
// folder slash and nowhere else.
const breakable = (name: string) => name.replaceAll('/', '/<wbr>');

type Feature = {
  readonly icon: IconName;
  readonly title: string;
  // Rendered bold before the body: the claim to take away from the tile.
  readonly lead: string;
  readonly body: string;
};

// Two tiles fill the bento's second row next to the tall tile. Caching is in the stats band.
const features: readonly Feature[] = [
  {
    icon: 'layers',
    title: 'Right colors, per icon',
    lead: 'Mono icons follow currentColor, multicolor icons keep their colors.',
    body: 'Gradients, masks and filters render in Chromium, Firefox and WebKit.',
  },
  {
    icon: 'git-branch',
    title: 'Plain files, no plugin',
    lead: 'A CLI that writes static files.',
    body: 'They are byte-identical on Linux, macOS and Windows. Turbopack, webpack and Vite need no plugin. svgworm check fails CI when the output is stale.',
  },
];

// The live color demo: radios pick a text color, :has() applies it to the stage (no JS).
const swatches = [
  { id: 'clay', label: 'Red clay', color: '#933a43' },
  { id: 'sienna', label: 'Sienna', color: '#b07a52' },
  { id: 'moss', label: 'Moss', color: '#3d7a5c' },
  { id: 'river', label: 'River blue', color: '#3b5f9a' },
] as const;
const swatchStyle = swatches
  .map(
    (swatch) =>
      `.color-demo:has(#swatch-${swatch.id}:checked) .color-stage{color:${swatch.color}}`,
  )
  .join('');
const suggestions = ['terminal'] as const;

// The curated before/after demo (TSK-077). The names are real icons of this site's icons/ folder:
// building fails if one is renamed or removed, so the file tree cannot drift from the sprite.
const demoNames = [
  'check',
  'folder-open',
  'terminal',
  'emoji/snail',
] as const satisfies readonly IconName[];
const demoMissing = demoNames.filter((name) => !(name in manifest.icons));
if (demoMissing.length > 0) {
  throw new Error(`demo: not in the sprite: ${demoMissing.join(', ')}`);
}
const demoFolders = [
  ...new Set(
    demoNames
      .filter((name) => name.includes('/'))
      .map((name) => name.split('/')[0] ?? name),
  ),
];
const demoTree = [
  'icons/',
  ...demoNames
    .filter((name) => !name.includes('/'))
    .map((name) => `├── ${name}.svg`),
  ...demoFolders.flatMap((folder, index) => {
    const isLast = index === demoFolders.length - 1;
    const files = demoNames.filter((name) => name.startsWith(`${folder}/`));
    return [
      `${isLast ? '└' : '├'}── ${folder}/`,
      ...files.map(
        (name, fileIndex) =>
          `${isLast ? ' ' : '│'}   ${fileIndex === files.length - 1 ? '└' : '├'}── ${name.slice(folder.length + 1)}.svg`,
      ),
    ];
  }),
].join('\n');
const typeSample = [
  'type IconName =',
  ...iconNames.slice(0, 3).map((name) => `  | "${name}"`),
  '  | …',
].join('\n');
const terminalComment = `// <svg><use href="${spriteUrl}#${terminalId}"/></svg>`;
---

<main class="landing" id="content" tabindex="-1">
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">
          <span class="dot"></span> v{version} on npm · MIT · Node ^22.20 || >=24.11
        </p>
        <h1>
          Your SVGs.
          <br />
          <span class="squiggle">One sprite.</span>
        </h1>
        <p class="lede">
          Drop in the SVGs your designers export. svgworm writes <strong
            >one content-hashed sprite</strong
          > and a type with every icon name. Logos keep their colors, mono icons
          follow <code>currentColor</code>, and a typo fails <code>tsc</code>.
          Render it in Next.js Server Components, Vite, Astro, Vue or Svelte with <strong
            >zero client JS</strong
          >, and no Turbopack plugin.
        </p>
        <Install id="hero" />
        <div class="actions">
          <a class="button" href="/docs/">
            Get started <Icon name="arrow-right" />
          </a>
          <a class="button button-ghost" href={REPO}>
            <Icon name="star" /> Star on GitHub
          </a>
        </div>
        <p class="hero-fit">
          Only using lucide or another icon set? Its React package is fine.
          svgworm is for the icons you own.
        </p>
        <div class="agent-prompt">
          <p class="agent-prompt-label">Or paste this into your coding agent</p>
          <pre aria-label="Prompt for your coding agent" class="code" data-copy role="region" tabindex="0"><code>{setupPrompt}</code></pre>
        </div>
      </div>

      <figure aria-label="svgworm build output" class="terminal">
        <div class="terminal-bar">
          <span></span>
          <span></span>
          <span></span>
          <code>~/my-app</code>
        </div>
        <pre aria-label="Build output" role="region" tabindex="0"><code><span class="t-prompt">$</span> pnpm svgworm
<span class="t-ok">svgworm: build done</span>
  icons     <span class="t-num">{iconNames.length}</span> ({monoIcons.length} mono, {multicolorIcons.length} multicolor)
  delivery  use {countDelivery('use')}, img {countDelivery('img')}, mask {countDelivery('mask')}
  output    <span class="t-num">{formatKib(spriteBytes)}</span>
  write     <span class="t-path">public{spriteUrl}</span>

<span class="t-prompt">$</span> pnpm tsc
<span class="t-err">error</span> TS2322: Type '"termnial"' is not
  assignable to type 'IconName'.</code></pre>
      </figure>
    </div>
  </section>

  <Soil />

  <section aria-label="This page in numbers" class="stats">
    <div class="wrap stats-grid">
      <div>
        <strong>0 B</strong>
        <span>JavaScript for icons</span>
      </div>
      <div>
        <strong>1 request</strong>
        <span>for all {iconNames.length} icons</span>
      </div>
      <div>
        <strong>{formatKib(spriteBytes)}</strong>
        <span>the whole sprite</span>
      </div>
      <div>
        <strong>1 year</strong>
        <span>immutable browser cache</span>
      </div>
    </div>
    <p class="wrap stats-caption">
      These numbers are from this page's own build: the sprite it loads and the
      headers it is served with.
    </p>
  </section>

  <section aria-labelledby="demo" class="section section-raised">
    <div class="wrap">
      <p class="kicker">From folder to typed icon</p>
      <h2 id="demo">What svgworm does to your SVG files.</h2>
      <p class="section-lede">
        A curated demo, not a live build. The file names come from this site's
        own <code>icons/</code> folder. The icons in step 3 are drawn from <strong
          >this page's real sprite</strong
        >.
      </p>
      <ol class="steps demo-steps">
        <li>
          <h3>Your SVG files</h3>
          <p>One file per icon, in any folders you like.</p>
          <pre aria-label="Source SVG files" class="code" role="region" tabindex="0"><code>{demoTree}</code></pre>
        </li>
        <li>
          <h3>One sprite and a type</h3>
          <p>
            <code>svgworm</code> writes a hashed sprite and the icon names as a
            type. <strong>A wrong name fails <code>tsc</code>.</strong>
          </p>
          <pre aria-label="Generated files" class="code" role="region" tabindex="0"><code><span class="c-comment">// generated</span>
public{spriteUrl}
svgworm/icons.d.ts

<span class="c-comment">// svgworm/icons.d.ts</span>
{typeSample}</code></pre>
          <pre aria-label="Typed icon usage" class="code" role="region" tabindex="0"><code><span class="c-tag">&lt;Icon</span> <span class="c-attr">name</span>=<span class="c-str">"terminal"</span> <span class="c-tag">/&gt;</span>
<span class="c-tag">&lt;Icon</span> <span class="c-attr">name</span>=<span class="c-str c-error">"termnial"</span> <span class="c-tag">/&gt;</span>
<span class="c-comment">// error TS2322: "termnial" is
// not assignable to IconName</span></code></pre>
        </li>
        <li>
          <h3>Rendered from the sprite</h3>
          <p>
            Each icon is a <code>&lt;use href&gt;</code> into
            <code>{spriteUrl}</code>. <strong
              >No icon code reaches the browser.</strong
            >
          </p>
          <div class="demo-icons">
            {
              demoNames.map((name) => (
                <span class="demo-icon">
                  <Icon height={40} name={name} width={40} />
                  <code set:html={breakable(name)} />
                </span>
              ))
            }
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section aria-labelledby="why" class="section">
    <div class="wrap">
      <p class="kicker">Why svgworm</p>
      <h2 id="why">Icons that render right, with no config.</h2>
      <p class="section-lede">
        A sprite tool has to decide, per icon, whether to turn its fills into
        <code>currentColor</code>. Do it for the whole folder and logos turn
        into black blobs; never do it and mono icons ignore dark mode. svgworm
        decides per icon: on 31,390 icons it agreed with the rendering 99.98%
        of the time, and it <strong>recolored 0 multicolor icons</strong>.{' '}
        <a href="https://github.com/jmlweb/svgworm/blob/main/docs/posts/per-icon-color.md"
          >How it decides</a
        >.
      </p>
      <p class="section-lede">
        Everything else stays out of your bundle: SVGR turns every icon into
        JavaScript, svgworm ships <strong>one cached file and a name</strong>.{' '}
        <a href="/docs/comparison/">How it compares with SVGR and @neodx/svg</a>.
      </p>
      <div class="bento">
        <article class="tile tile-wide">
          <div class="tile-head">
            <span class="badge"><Icon name="zap" /></span>
            <h3>Rendered on the server</h3>
          </div>
          <p>
            Each icon is a tiny <code>&lt;use href&gt;</code> into one hashed sprite.
            The browser <strong>fetches the sprite once</strong> and keeps it.
          </p>
          <pre aria-label="Icon usage and generated markup" class="code" role="region" tabindex="0"><code><span class="c-tag">&lt;Icon</span> <span class="c-attr">name</span>=<span class="c-str">"terminal"</span> <span class="c-tag">/&gt;</span>
<span class="c-comment">{terminalComment}</span></code></pre>
        </article>
        <article class="tile tile-tall">
          <div class="tile-head">
            <span class="badge"><Icon name="shield-check" /></span>
            <h3>Type-safe names</h3>
          </div>
          <p>
            The generated types list every icon. <strong
              >A typo fails <code>tsc</code>, not production.</strong
            >
          </p>
          <pre aria-label="Icon usage with a misspelled name" class="code" role="region" tabindex="0"><code><span class="c-tag">&lt;Icon</span> <span class="c-attr">name</span>=<span class="c-str c-error">"termnial"</span> <span class="c-tag">/&gt;</span></code></pre>
          <div aria-hidden="true" class="suggest">
            <p class="suggest-input">
              <span class="c-tag">&lt;Icon</span>{' '}
              <span class="c-attr">name</span>=<span class="c-str">"te</span
              ><span class="caret"></span>
            </p>
            <ul>
              {
                suggestions.map((name, index) => (
                  <li class={index === 0 ? 'active' : undefined}>
                    <Icon name={name} />
                    <code>{name}</code>
                    <small>IconName</small>
                  </li>
                ))
              }
            </ul>
          </div>
          <ul class="checks">
            <li><Icon name="check" /> Autocomplete in your editor</li>
            <li><Icon name="check" /> Checked with TypeScript 6 and 7</li>
            <li><Icon name="check" /> Clear errors for collisions</li>
            <li><Icon name="check" /> Renamed icons fail the type check</li>
          </ul>
        </article>
        {
          features.map((feature) => (
            <article class="tile">
              <div class="tile-head">
                <span class="badge">
                  <Icon name={feature.icon} />
                </span>
                <h3>{feature.title}</h3>
              </div>
              <p>
                <strong>{feature.lead}</strong> {feature.body}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section aria-labelledby="agents" class="section section-raised">
    <div class="wrap agents">
      <div>
        <p class="kicker">Built for AI agents too</p>
        <h2 id="agents">Your agent can set it up.</h2>
        <p>
          <strong>Everything works without a prompt:</strong> flags,
          <code>--json</code>, stable exit codes, a JSON Schema for the config,
          and <a href="/llms.txt">llms.txt</a>. The agent skills install svgworm
          in a Next.js or an Astro app. They also explain each diagnostic code
          with its fix.
        </p>
      </div>
      <figure class="terminal terminal-small">
        <div class="terminal-bar">
          <span></span>
          <span></span>
          <span></span>
          <Icon name="terminal" />
        </div>
        <pre aria-label="Agent skill install commands" role="region" tabindex="0"><code><span class="t-prompt">$</span> npx skills add jmlweb/svgworm --skill svgworm-nextjs
<span class="t-prompt">$</span> npx skills add jmlweb/svgworm --skill svgworm-astro</code></pre>
      </figure>
      <div class="agent-migrate">
        <h3>Moving from SVGR, or mixing an icon set with your own SVGs?</h3>
        <p>Move them into one sprite. Paste one of these prompts into your agent.</p>
        {
          migrationPrompts.map((prompt) => (
            <div class="agent-prompt">
              <p class="agent-prompt-label">{prompt.label}</p>
              <pre aria-label={`Prompt: ${prompt.label}`} class="code" data-copy role="region" tabindex="0"><code>{prompt.text}</code></pre>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section aria-labelledby="proof" class="section section-dark">
    <div class="wrap">
      <p class="kicker">This page is the demo</p>
      <h2 id="proof">Every icon here is one sprite.</h2>
      <p class="section-lede">
        <code>{spriteUrl}</code>, rendered by the generated <code>Icon.astro</code
        > at build time. It is served with <code>Cache-Control: immutable</code>.
        Open your network panel: <strong
          >one icon sprite and no JavaScript to render it</strong
        >.
      </p>
      <div class="showcase-group">
        <h3>
          Multicolor <small>{multicolorIcons.length} icons, colors kept</small>
        </h3>
        <ul
          aria-label="Multicolor icons from the sprite"
          class="showcase showcase-multi"
        >
          {
            multicolorIcons.map((name) => (
              <li>
                <Icon height={48} name={name} width={48} />
                <code set:html={breakable(name)} />
              </li>
            ))
          }
        </ul>
      </div>
      <div class="showcase-group">
        <h3>
          Mono <small>{monoIcons.length} icons, follow currentColor</small>
        </h3>
        <ul aria-label="Mono icons from the sprite" class="showcase">
          {
            monoIcons.map((name) => (
              <li>
                <Icon height={32} name={name} width={32} />
                <code set:html={breakable(name)} />
              </li>
            ))
          }
        </ul>
      </div>
      <div class="color-demo">
        <style set:html={swatchStyle} />
        <p>
          Same sprite, same <code>&lt;use href&gt;</code>, <strong
            >decided per icon</strong
          >. Pick a text color. The mono folder follows it; the multicolor snail
          keeps its own colors. No JavaScript, only CSS <code>color</code>.
        </p>
        <fieldset class="swatches">
          <legend class="visually-hidden">Text color</legend>
          {
            swatches.map((swatch, index) => (
              <label class="swatch" style={`--swatch:${swatch.color}`}>
                <input
                  checked={index === 0}
                  id={`swatch-${swatch.id}`}
                  name="swatch"
                  type="radio"
                  value={swatch.id}
                />
                <span class="visually-hidden">{swatch.label}</span>
              </label>
            ))
          }
        </fieldset>
        <p class="color-stage">
          <Icon height={56} name="folder-open" width={56} />
          <Icon height={56} name="emoji/snail" width={56} />
        </p>
      </div>
    </div>
  </section>

  <section aria-labelledby="start" class="section section-raised">
    <div class="wrap">
      <p class="kicker">Get started in Next.js</p>
      <h2 id="start">Three steps, no bundler config.</h2>
      <ol class="steps">
        <li>
          <h3>Install and set up</h3>
          <p>
            <code>init</code> writes the config, the <code>predev</code>/<code
              >prebuild</code
            > scripts and the component. Then it builds once, so <strong
              >the app runs before you add an icon</strong
            >.
          </p>
          <pre aria-label="Install commands" class="code" role="region" tabindex="0"><code>pnpm add -D svgworm
pnpm add @svgworm/react
pnpm svgworm init</code></pre>
        </li>
        <li>
          <h3>Drop SVGs in icons/ and build</h3>
          <p>
            Each run writes a hashed sprite to <code>public/icons/</code> and a typed
            manifest to <code>svgworm/</code>. <strong
              ><code>predev</code> and <code>prebuild</code> run it for you.</strong
            >
          </p>
          <pre aria-label="Icons folder and build command" class="code" role="region" tabindex="0"><code>icons/
├── home.svg
├── search.svg
└── brand/logo.svg

pnpm svgworm</code></pre>
        </li>
        <li>
          <h3>Render in a Server Component</h3>
          <p>
            <strong>Decorative by default.</strong> Pass <code>title</code> or
            <code>label</code> for an accessible name.
          </p>
          <pre aria-label="Icon usage in a Server Component" class="code" role="region" tabindex="0"><code><span class="c-tag">&lt;Icon</span> <span class="c-attr">name</span>=<span class="c-str">"home"</span> <span class="c-tag">/&gt;</span>
<span class="c-tag">&lt;Icon</span> <span class="c-attr">name</span>=<span class="c-str">"home"</span> <span class="c-attr">title</span>=<span class="c-str">"Home"</span> <span class="c-tag">/&gt;</span></code></pre>
        </li>
      </ol>
      <p class="more">
        Caching, <code>basePath</code> and manual setup are in the{' '}
        <a href="/docs/nextjs/">Next.js guide</a>. A complete app lives
        in{' '}
        <a href={`${REPO}/tree/main/examples/next-app-router`}>
          examples/next-app-router
        </a>
        .
      </p>
    </div>
  </section>

  <GuideCards />

  <section aria-labelledby="try" class="section cta">
    <div class="wrap cta-inner">
      <h2 id="try">Point it at your icon folder.</h2>
      <p>
        One <code>init</code>, Next.js, Vite, Astro, Vue or Svelte, and your icons ship as <strong
          >one cached file</strong
        >.
      </p>
      <Install id="cta" />
      <div class="actions">
        <a class="button" href="/docs/">
          Get started <Icon name="arrow-right" />
        </a>
        <a class="button button-ghost" href={REPO}>
          <Icon name="star" /> Star on GitHub
        </a>
      </div>
    </div>
  </section>
</main>
<CopyButtons />
