---
const REPO = 'https://github.com/jmlweb/svgworm';

const groups = [
  {
    label: 'Use it',
    links: [
      { href: '/docs/cli/', text: 'CLI' },
      { href: '/docs/config/', text: 'Config' },
      { href: '/docs/troubleshooting/', text: 'Troubleshooting' },
    ],
  },
  {
    label: 'How it works',
    links: [
      { href: `${REPO}/blob/main/docs/output-contract.md`, text: 'Output contract' },
      { href: `${REPO}/tree/main/docs/adr`, text: 'Decisions' },
      { href: '/llms.txt', text: 'llms.txt' },
    ],
  },
  {
    label: 'Project',
    links: [
      { href: 'https://www.npmjs.com/package/svgworm', text: 'npm' },
      { href: `${REPO}/issues`, text: 'Issues' },
      { href: `${REPO}/discussions`, text: 'Discussions' },
    ],
  },
] as const;
---

<footer class="site-footer">
  <div class="wrap footer-row">
    <img
      alt=""
      class="footer-mark"
      height="32"
      src="/favicon.svg"
      width="32"
    />
    <p>
      MIT licensed. Icons on this site are from{' '}
      <a href="https://lucide.dev">Lucide</a> (ISC) and{' '}
      <a href="https://github.com/microsoft/fluentui-emoji">Fluent Emoji</a> (MIT).
    </p>
    <nav aria-label="Footer">
      {
        groups.map((group) => (
          <div>
            <p class="footer-label">{group.label}</p>
            <ul>
              {group.links.map((link) => (
                <li>
                  <a href={link.href}>{link.text}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>
</footer>
