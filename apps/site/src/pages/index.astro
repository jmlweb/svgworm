---
import Landing from '../components/Landing.astro';
import Base from '../layouts/Base.astro';

const title = 'svgworm: SVG icons in the right colors, as a typed sprite';
const description =
  'Your SVGs render right: mono icons follow currentColor, multicolor icons keep their colors, and gradients and masks keep working. Typed names, zero client JS.';
---

<Base title={title} description={description} path="/">
  <Landing />
</Base>
