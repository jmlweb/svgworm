---
import { getCollection } from 'astro:content';

import DocsNav from '../../components/DocsNav.astro';
import Base from '../../layouts/Base.astro';

const docs = (await getCollection('docs')).toSorted(
  (a, b) => a.data.order - b.data.order,
);
---

<Base
  title="svgworm docs"
  description="Guides and references for svgworm: set it up in Next.js or Astro, every CLI command and flag, the config file, and how it compares with other SVG icon tools."
  path="/docs/"
>
  <div class="wrap docs-layout">
    <DocsNav current="/docs/" docs={docs} />
    <main class="docs-main" id="content">
      <article class="prose">
        <h1>svgworm docs</h1>
        <ul class="docs-list">
          {
            docs.map((doc) => (
              <li>
                <a href={`/docs/${doc.id}/`}>{doc.data.title}</a>
                <p>{doc.data.description}</p>
              </li>
            ))
          }
        </ul>
      </article>
    </main>
  </div>
</Base>
