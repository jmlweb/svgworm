---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

import DocsNav from '../../components/DocsNav.astro';
import Icon from '../../components/Icon.astro';
import Base from '../../layouts/Base.astro';

export const getStaticPaths = async () => {
  const docs = (await getCollection('docs')).toSorted(
    (a, b) => a.data.order - b.data.order,
  );
  return docs.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, docs },
  }));
};

type Props = {
  readonly entry: CollectionEntry<'docs'>;
  readonly docs: readonly CollectionEntry<'docs'>[];
};

const { entry, docs } = Astro.props;
const { headings } = await render(entry);
const path = `/docs/${entry.id}/`;
const sections = headings.filter((heading) => heading.depth === 2);
const index = docs.findIndex((doc) => doc.id === entry.id);
const previous = docs[index - 1];
const next = docs[index + 1];
const navTitle = (doc: CollectionEntry<'docs'>) =>
  doc.data.navTitle ?? doc.data.title;

// Heading anchors (TSK-072). Astro assigns the ids after user rehype plugins run, so the link is
// added to the rendered HTML instead, which keeps every id exactly as the TOC and deep links
// already use it. The content layer renders Markdown to a string, so this is the same HTML
// <Content /> would print.
const rendered = entry.rendered?.html;
if (rendered === undefined) {
  throw new Error(`docs: "${entry.id}" has no rendered HTML`);
}
const withAnchors = rendered.replace(
  /<h([23]) id="([^"]+)">([\s\S]*?)<\/h\1>/g,
  (_, level: string, id: string, inner: string) =>
    `<h${level} id="${id}">${inner}<a class="heading-anchor" href="#${id}" aria-label="Link to this section">#</a></h${level}>`,
);

// Tables (TSK-084): a table wider than the column scrolls inside a focusable, named region, so a
// keyboard user can scroll it. The name is the section the table sits in.
const plainText = (markup: string) =>
  markup
    .replace(/<a class="heading-anchor"[\s\S]*?<\/a>/g, '')
    .replace(/<[^>]+>/g, '')
    .trim();
const seen = new Map<string, number>();
const html = withAnchors.replace(
  /<table[\s\S]*?<\/table>/g,
  (table: string, offset: number) => {
    const before = [
      ...withAnchors.slice(0, offset).matchAll(/<h[23] [^>]*>([\s\S]*?)<\/h[23]>/g),
    ].at(-1);
    const section = before ? plainText(before[1] ?? '') : entry.data.title;
    // Region names must be unique on a page: a second table in a section gets a number.
    const count = (seen.get(section) ?? 0) + 1;
    seen.set(section, count);
    const name = count === 1 ? section : `${section} (${String(count)})`;
    return `<div aria-label="Table: ${name.replaceAll('"', '&quot;')}" class="table-scroll" role="region" tabindex="0">${table}</div>`;
  },
);
---

<Base
  title={`${entry.data.title} | svgworm docs`}
  description={entry.data.description}
  path={path}
  ogType="article"
>
  <div class="wrap docs-layout">
    <DocsNav current={path} docs={docs} sections={sections} />
    <main class="docs-main" id="content">
      <article class="prose">
        <h1>{entry.data.title}</h1>
        <div set:html={html} />
      </article>
      {
        (previous || next) && (
          <nav aria-label="Previous and next page" class="docs-pager">
            {previous && (
              <a href={`/docs/${previous.id}/`} rel="prev">
                <span>Previous</span>
                {navTitle(previous)}
              </a>
            )}
            {next && (
              <a class="docs-pager-next" href={`/docs/${next.id}/`} rel="next">
                <span>Next</span>
                {navTitle(next)}
              </a>
            )}
          </nav>
        )
      }
      <p class="docs-edit">
        <a
          href={`https://github.com/jmlweb/svgworm/blob/main/apps/site/src/content/docs/${entry.id}.md`}
          >Edit this page on GitHub</a
        >
      </p>
    </main>
    {
      /* The sections as a right rail from 1200px (TSK-071); below that they stay nested in
         the left nav. Without JavaScript it is a plain list of links. */
      sections.length > 0 && (
        <aside class="docs-rail">
          <nav aria-label="On this page">
            <p class="docs-nav-title">On this page</p>
            <ul>
              {sections.map((section) => (
                <li>
                  <a href={`#${section.slug}`}>{section.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )
    }
  </div>

  {/* Copy buttons (TSK-069): the script adds one per code block, so without JavaScript there
      is no button. Docs pages only; the landing page stays script-free for icons. The icon
      comes from the sprite through this template. */}
  <template id="copy-button">
    <button class="copy-button" type="button">
      <Icon name="copy" />
      <span class="copy-button-label">Copy</span>
    </button>
  </template>
  <script>
    // Scroll-spy for the right rail: the last heading above the top third of the viewport is
    // the current section. Headings only, so the cost is one observer per h2.
    const railLinks = [
      ...globalThis.document.querySelectorAll<HTMLAnchorElement>('.docs-rail a'),
    ];
    const headings = railLinks
      .map((link) =>
        globalThis.document.getElementById(
          decodeURIComponent(link.getAttribute('href')?.slice(1) ?? ''),
        ),
      )
      .filter((heading): heading is HTMLElement => heading !== null);
    if (headings.length > 0) {
      const mark = () => {
        const line = globalThis.innerHeight / 3;
        const current = headings.findLast(
          (heading) => heading.getBoundingClientRect().top <= line,
        );
        railLinks.forEach((link) => {
          const isCurrent =
            current !== undefined && link.getAttribute('href') === `#${current.id}`;
          if (isCurrent) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
      };
      // Heading positions only change on scroll or resize, so no observer is needed.
      globalThis.addEventListener('scroll', mark, { passive: true });
      globalThis.addEventListener('resize', mark);
      mark();
    }

    const template =
      globalThis.document.querySelector<HTMLTemplateElement>('#copy-button');
    const blocks = globalThis.document.querySelectorAll<HTMLPreElement>(
      '.prose pre',
    );
    if (template && 'clipboard' in globalThis.navigator) {
      blocks.forEach((pre) => {
        const button = template.content.firstElementChild?.cloneNode(true);
        if (!(button instanceof globalThis.HTMLButtonElement)) return;
        const label = button.querySelector('.copy-button-label');
        button.setAttribute('aria-label', 'Copy code');
        button.addEventListener('click', async () => {
          const text = pre.querySelector('code')?.textContent ?? pre.textContent ?? '';
          try {
            await globalThis.navigator.clipboard.writeText(text);
            if (label) label.textContent = 'Copied';
            button.setAttribute('aria-label', 'Copied');
          } catch {
            if (label) label.textContent = 'Press Ctrl+C';
          }
          globalThis.setTimeout(() => {
            if (label) label.textContent = 'Copy';
            button.setAttribute('aria-label', 'Copy code');
          }, 2000);
        });
        pre.append(button);
      });
    }
  </script>
</Base>
